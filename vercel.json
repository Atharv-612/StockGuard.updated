{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/alerts/:sub", "destination": "/api/alerts?sub=:sub" },
    { "source": "/api/reports/:sub", "destination": "/api/reports?sub=:sub" },
    { "source": "/api/batches/:id/dispose", "destination": "/api/batches?id=:id&action=dispose" },
    { "source": "/api/batches/:id", "destination": "/api/batches?id=:id" },
    { "source": "/api/products/:id", "destination": "/api/products?id=:id" }
  ]
}
