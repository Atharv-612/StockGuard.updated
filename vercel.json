{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/alerts/:path*", "destination": "/api/alerts" },
    { "source": "/api/reports/:path*", "destination": "/api/reports" },
    { "source": "/api/batches/:id/dispose", "destination": "/api/batches/[id]" },
    { "source": "/api/batches/:id", "destination": "/api/batches/[id]" },
    { "source": "/api/products/:id", "destination": "/api/products" }
  ]
}
